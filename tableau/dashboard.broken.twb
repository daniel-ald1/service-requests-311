<?xml version='1.0' encoding='utf-8' ?>
<!-- I connect this workbook to ../data_clean/requests_clean.csv with a path
     relative to this file, so Tableau Public opens it without remapping.
     Escaping check: the path contains no &amp; &lt; &gt; quotes, so no entities needed. -->
<workbook source-platform='win' version='18.1'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
  </preferences>
  <datasources>
    <datasource caption='requests_clean' inline='true' name='textscan.requests_clean'>
      <connection class='textscan' directory='' filename='../data_clean/requests_clean.csv' header='yes'>
        <relation name='requests_clean.csv' table='[requests_clean.csv]' type='table' />
      </connection>
      <column caption='Request ID' datatype='string' name='[request_id]' role='dimension' type='nominal' />
      <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
      <column caption='Closed Date' datatype='date' name='[closed_date]' role='dimension' type='ordinal' />
      <column caption='District' datatype='string' name='[district]' role='dimension' type='nominal' />
      <column caption='Request Type' datatype='string' name='[request_type]' role='dimension' type='nominal' />
      <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
      <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
      <column caption='Priority' datatype='string' name='[priority]' role='dimension' type='nominal' />
      <column caption='Response Days' datatype='integer' name='[response_days]' role='measure' type='quantitative' />
      <column caption='Satisfaction' datatype='integer' name='[satisfaction]' role='measure' type='quantitative' />
      <column caption='Resolution Days' datatype='real' name='[resolution_days]' role='measure' type='quantitative' />
      <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='ordinal' />
      <column caption='Number of Records' datatype='integer' name='[:Number of Records]' role='measure' type='quantitative' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Monthly trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='requests_clean' name='textscan.requests_clean' />
          </datasources>
          <datasource-dependencies datasource='textscan.requests_clean'>
            <column datatype='string' name='[created_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[:Number of Records]' role='measure' type='quantitative' />
            <column datatype='string' name='[priority]' role='dimension' type='nominal' />
            <column datatype='string' name='[request_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[created_month]'>
            <groupfilter function='level' level='[created_month]' />
          </filter>
          <filter class='categorical' column='[priority]'>
            <groupfilter function='level' level='[priority]' />
          </filter>
          <filter class='categorical' column='[request_type]'>
            <groupfilter function='level' level='[request_type]' />
          </filter>
        </view>
        <rows>SUM([:Number of Records])</rows>
        <cols>[created_month]</cols>
      </table>
    </worksheet>
    <worksheet name='Top types'>
      <table>
        <view>
          <datasources>
            <datasource caption='requests_clean' name='textscan.requests_clean' />
          </datasources>
          <datasource-dependencies datasource='textscan.requests_clean'>
            <column datatype='string' name='[request_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[:Number of Records]' role='measure' type='quantitative' />
            <column datatype='string' name='[created_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[priority]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[created_month]'>
            <groupfilter function='level' level='[created_month]' />
          </filter>
          <filter class='categorical' column='[priority]'>
            <groupfilter function='level' level='[priority]' />
          </filter>
          <filter class='categorical' column='[request_type]'>
            <groupfilter function='level' level='[request_type]' />
          </filter>
        </view>
        <rows>[request_type]</rows>
        <cols>SUM([:Number of Records])</cols>
      </table>
    </worksheet>
    <worksheet name='Avg resolution by priority'>
      <table>
        <view>
          <datasources>
            <datasource caption='requests_clean' name='textscan.requests_clean' />
          </datasources>
          <datasource-dependencies datasource='textscan.requests_clean'>
            <column datatype='string' name='[priority]' role='dimension' type='nominal' />
            <column datatype='real' name='[resolution_days]' role='measure' type='quantitative' />
            <column datatype='string' name='[created_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[request_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[created_month]'>
            <groupfilter function='level' level='[created_month]' />
          </filter>
          <filter class='categorical' column='[priority]'>
            <groupfilter function='level' level='[priority]' />
          </filter>
          <filter class='categorical' column='[request_type]'>
            <groupfilter function='level' level='[request_type]' />
          </filter>
        </view>
        <rows>AVG([resolution_days])</rows>
        <cols>[priority]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='311 overview'>
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' />
      <zones>
        <zone h='900000' type-v2='layout-basic' w='1600000' x='0' y='0'>
          <zone fixed-size='1' h='90000' id='1' type-v2='text' w='1600000' x='0' y='0'>
            <text>
              <formatted-text>
                <run font-size='20'>311 service requests — overview</run>
              </formatted-text>
            </text>
          </zone>
          <zone fixed-size='1' h='110000' id='2' type-v2='text' w='533333' x='0' y='90000'>
            <text>
              <formatted-text>
                <run font-size='14'>Total requests: 1000</run>
              </formatted-text>
            </text>
          </zone>
          <zone fixed-size='1' h='110000' id='3' type-v2='text' w='533333' x='533333' y='90000'>
            <text>
              <formatted-text>
                <run font-size='14'>Backlog (Open + In Progress): 26.1%</run>
              </formatted-text>
            </text>
          </zone>
          <zone fixed-size='1' h='110000' id='4' type-v2='text' w='533334' x='1066666' y='90000'>
            <text>
              <formatted-text>
                <run font-size='14'>Top type: Noise Complaint (145)</run>
              </formatted-text>
            </text>
          </zone>
          <zone h='330000' id='5' name='Monthly trend' type-v2='worksheet' w='1600000' x='0' y='200000' />
          <zone h='370000' id='6' name='Top types' type-v2='worksheet' w='800000' x='0' y='530000' />
          <zone h='370000' id='7' name='Avg resolution by priority' type-v2='worksheet' w='800000' x='800000' y='530000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows>
    <window class='dashboard' name='311 overview' />
    <window class='worksheet' name='Monthly trend' />
    <window class='worksheet' name='Top types' />
    <window class='worksheet' name='Avg resolution by priority' />
  </windows>
</workbook>
